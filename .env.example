# Public client configuration. Development automatically uses frontend-host:3001.
# Production builds require the real secure backend URL; no production localhost fallback.
# VITE_MULTIPLAYER_URL=wss://your-actual-service.example/ws

# Local Node server (npm run start:server); shell environment overrides defaults.
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
MAX_ROOMS=20
MAX_SOCKETS=100
# LAN testing: explicitly add your frontend's full origin, e.g. http://192.168.1.10:5173.
# The server uses the transport IP unless an explicit trusted-proxy list is configured.

# Operations. LOG_LEVEL: silent or info (allowlisted lifecycle metadata only).
LOG_LEVEL=info
# Leave empty until actual ingress IP ranges and header behavior are verified.
# Explicit CIDRs only, e.g. 127.0.0.1/32 for a trusted LOCAL development proxy.
TRUSTED_PROXY_CIDRS=
